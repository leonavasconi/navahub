# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponha a service role key no cliente: só usada em código de servidor (uploads, scripts).
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project Settings > Database > Connection string
# DATABASE_URL: connection pooling (porta 6543, pgbouncer=true) — usada pelo Prisma Client em runtime (src/lib/prisma.ts)
# DIRECT_URL: conexão direta (porta 5432) — usada pelo Prisma CLI (migrate/seed/studio, ver prisma.config.ts).
#             Migrations usam advisory locks que não funcionam de forma confiável atrás do pooler em modo transaction.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Nome do bucket privado no Supabase Storage usado para os anexos
SUPABASE_STORAGE_BUCKET=attachments
